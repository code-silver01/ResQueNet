# Google Gemini API Key (Get a free key from Google AI Studio: https://aistudio.google.com)
# If omitted or left empty, RESQNET automatically falls back to its built-in deterministic heuristic parser.
GEMINI_API_KEY=your_gemini_api_key_here

# Playwright execution mode
# true  = headless background execution (default for servers)
# false = headed mode (Chromium window visibly opens on your screen so you can watch form navigation live!)
PLAYWRIGHT_HEADLESS=true

# Application base URL for mock portals and internal API calls
NEXT_PUBLIC_BASE_URL=http://localhost:3000
